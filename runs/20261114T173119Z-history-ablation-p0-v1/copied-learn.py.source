def learn(self, sequence, target, *, head='action', reward=1.0, evidence=None, remember=True):
    if not isinstance(evidence, dict) or evidence.get('kind') not in ('human_feedback', 'machine_verifier') or (not evidence.get('id')):
        raise ValueError('Learning needs identified human feedback or machine verification')
    if not np.isfinite(reward) or not -1 <= reward <= 1:
        raise ValueError('Invalid reward')
    xp = self.xp
    p, f, raw, scale, indices = self._forward_native(sequence, head, track=True)
    if type(target) is not int or not 0 <= target < len(indices):
        raise ValueError('Invalid action/label')
    loss = -float(xp.log(xp.maximum(p[target].astype(xp.float64), 1e-12)))
    before = {k: v.copy() for k, v in self.core.arrays().items() if k.startswith('w_')}
    if self.mode != 'frozen':
        error = -p.copy()
        error[target] += 1.0
        error *= float(reward)
        signal = self.core.w_out[indices].T @ error * (xp.abs(raw) < 5) / scale
        self.core.w_out[indices] += xp.clip(0.04 * error[:, None] * f[None, :], -0.025, 0.025)
        self.core.bias[indices] += xp.clip(0.04 * error, -0.025, 0.025)
        if self.mode in ('learned', 'shuffled'):
            if self.mode == 'shuffled':
                signal = signal[xp.asarray(self.signal_rng.permutation(128))]
            direction = signal[:, None] * self.e_f
            delta = self._history_update(direction)
            self.core.w_in += delta[:, :64]
            self.core.w_rec += delta[:, 64:]
            self.hidden_updates += 1
        for name in ('w_in', 'w_rec', 'w_out', 'bias'):
            xp.clip(getattr(self.core, name), -3.0, 3.0, out=getattr(self.core, name))
        self.updates += 1
        self.core.updates += 1
    if not all((xp.isfinite(a).all() for a in self.arrays().values())):
        raise FloatingPointError('Nonfinite local update')
    if self.mode != 'frozen':
        self.f_mean[:] = 0.99 * self.f_mean + 0.01 * self.core.features
        self.f_var[:] = 0.99 * self.f_var + 0.01 * (self.core.features - self.f_mean) ** 2
    if remember and self.mode != 'frozen':
        item = {'sequence': np.asarray(sequence, np.float32).tolist(), 'target': target, 'head': head, 'reward': float(reward), 'evidence': evidence}
        self.replay_seen += 1
        if len(self.replay) < 64:
            self.replay.append(item)
        else:
            index = int(self.rng.integers(self.replay_seen))
            if index < 64:
                self.replay[index] = item
    return {'loss': loss, 'updates': self.updates, 'hidden_updates': self.hidden_updates, 'weight_delta': {k: float(xp.linalg.norm(getattr(self.core, k) - v)) for k, v in before.items()}, 'accepted': True, 'mode': self.mode, 'reward': float(reward), 'evidence': evidence}