runs/*-neural-outcome-bridge-p1a-v2-*/cuda-cache/
# Keep the zero-call loader failure's full base snapshot and redundant tokenizer copies local.
artifacts/*-native-lora-repair-v1-*/unqualified-partial-adapter/
